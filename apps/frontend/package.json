{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "cross-env VITE_SUPABASE_URL=https://example.supabase.co VITE_SUPABASE_ANON_KEY=dummy-key vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && npx playwright test --config=playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=playwright.config.ts --ui",
    "test:e2e:dev": "BASE_URL=http://localhost:5173 npx playwright test --config=playwright.config.ts",
    "test:e2e:fullstack": "cross-env BASE_URL=http://localhost:5173 npx playwright test e2e/items-crud.spec.ts --config=playwright.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.3.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^23.2.0",
    "vite": "^5.0.8",
    "vitest": "^1.2.2"
  }
}
